<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleetlink</name>
  <version>0.1.0</version>
  <description>QoS-aware robot to base-station bridge for live Hydra scene graphs, meshes and robot state over zenoh</description>
  <maintainer email="harelb@mit.edu">harelb</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>hydra_msgs</exec_depend>
  <exec_depend>robot_executor_msgs</exec_depend>
  <exec_depend>ros_system_monitor_msgs</exec_depend>
  <exec_depend>spark_dsg</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>
  <exec_depend>python3-zstandard</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
