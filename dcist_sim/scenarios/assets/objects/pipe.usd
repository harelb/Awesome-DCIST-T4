#usda 1.0
(
    defaultPrim = "pipe"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pipe" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Props/DeformableTube/tube.usd@
)
{
    float3 xformOp:scale = (4, 4, 4)
    double3 xformOp:translate = (0, 0, -0.0025)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

