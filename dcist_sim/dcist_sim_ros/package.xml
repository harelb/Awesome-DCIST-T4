<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dcist_sim_ros</name>
  <version>0.1.0</version>
  <description>Sim-backed implementation of the Spot interface for spot_executor, wired to Isaac Sim over ROS2</description>
  <maintainer email="harelb@mit.edu">Harel Biggie</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>dcist_sim_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>spot_tools</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
